        <!--Dialog对话框工具-->
        <activity
            android:name=".dialog.DialogAty"
            android:enabled="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="user"
            android:theme="@style/AppTheme" />
        <activity
            android:name=".network.NetRecordAty"
            android:enabled="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="user"
            android:theme="@style/AppTheme" />

        <!-- 设置USB功能 -->
