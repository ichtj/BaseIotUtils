<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center|top"
    android:orientation="vertical">
    <com.face_chtj.base_iotutils.view.TopTitleBar
        android:id="@+id/ctTopView"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:centerText="crash测试"
        app:leftIcon="@drawable/ic_back"
        app:leftIconSize="20dp"
        app:leftIconPadding="6dp"
        app:backgroundColor="#E6E4E4"
        app:textSize="18sp"
        app:textColor="@color/black"
        app:leftBack="true" />
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@mipmap/anr" />

    <TextView
        android:id="@+id/tvSn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:gravity="center"
        android:text="程序出现异常了噢" />

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:onClick="reStartApp"
        android:text="重新启动" />
</LinearLayout>