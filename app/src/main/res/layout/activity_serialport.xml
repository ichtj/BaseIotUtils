<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <com.face_chtj.base_iotutils.view.TopTitleBar
        android:id="@+id/ctTopView"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:centerText="@string/main_serial_rw"
        app:leftIcon="@drawable/ic_back"
        app:leftIconSize="20dp"
        app:leftIconPadding="6dp"
        app:backgroundColor="#E6E4E4"
        app:textSize="18sp"
        app:textColor="@color/black"
        app:leftBack="true" />

    <ScrollView
        android:layout_width="match_parent"
        android:scrollbars="none"
        android:fillViewport="true"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <RadioGroup
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:orientation="horizontal"
                android:paddingLeft="15dp"
                android:paddingTop="10dp">

                <RadioButton
                    android:id="@+id/rbHex"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:checked="true"
                    android:text="@string/serialport_hex_format"
                    android:layout_marginRight="15dp"
                    android:textColor="@color/black"
                    android:textSize="@dimen/small_text_size" />

                <RadioButton
                    android:id="@+id/rbTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/serialport_string_format"
                    android:textColor="@color/black"
                    android:textSize="@dimen/small_text_size" />
            </RadioGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="15dp"
                android:layout_weight="1"
                android:background="@drawable/button_style_stroke"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="right|center"
                                android:text="@string/serialport_dev_path"
                                android:textColor="@android:color/black"
                                android:textSize="@dimen/small_text_size" />

                            <Spinner
                                android:id="@+id/spCom"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                android:layout_weight="1"
                                android:textSize="@dimen/small_text_size" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="right|center"
                                android:text="@string/serialport_baudrate"
                                android:textColor="@android:color/black"
                                android:textSize="@dimen/small_text_size" />

                            <Spinner
                                android:id="@+id/spBurate"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                android:layout_weight="1"
                                android:entries="@array/burate"
                                android:textSize="@dimen/small_text_size" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnInit"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="@string/serialport_open"
                            android:textSize="@dimen/small_text_size"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etCommand"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:layout_marginRight="10dp"
                            android:layout_weight="1"
                            android:background="@drawable/button_style_stroke2"
                            android:hint="@string/serialport_input_cmd"
                            android:paddingLeft="10dp"
                            android:text="010300000002C40B"
                            android:textSize="@dimen/small_text_size" />

                        <EditText
                            android:id="@+id/etAuto"
                            android:layout_width="80dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:hint="@string/auto_send_cmd_millisecond"
                            android:inputType="number"
                            android:paddingLeft="10dp"
                            android:text="500"
                            android:textSize="@dimen/small_text_size" />

                        <CheckBox
                            android:id="@+id/cbMs"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:layout_marginLeft="10dp"
                            android:layout_marginRight="10dp"
                            android:gravity="center"
                            android:textSize="@dimen/small_text_size"
                            android:text="@string/serialport_auto" />

                        <Button
                            android:id="@+id/btnTestSend"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:text="@string/serialport_write_data"
                            android:textSize="@dimen/small_text_size" />
                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:gravity="left|center"
                            android:text="@string/serialport_receive_data"
                            android:textSize="@dimen/small_text_size" />

                        <Button
                            android:id="@+id/btnClear"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_gravity="right"
                            android:text="@string/serialport_clear"
                            android:textSize="@dimen/small_text_size" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvResult"
                        android:layout_width="match_parent"
                        android:layout_height="300dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_style_stroke2"
                        android:gravity="left|top"
                        android:scrollbars="vertical"
                        android:textSize="@dimen/small_text_size"
                        android:text="" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="15dp"
                android:layout_weight="1"
                android:background="@drawable/button_style_stroke"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:padding="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:layout_marginTop="15dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="right|center"
                                android:text="@string/serialport_dev_path"
                                android:textColor="@android:color/black"
                                android:textSize="18dp" />

                            <Spinner
                                android:id="@+id/spCom2"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                android:layout_weight="1"
                                android:textSize="18dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="right|center"
                                android:text="@string/serialport_baudrate"
                                android:textColor="@android:color/black"
                                android:textSize="18dp" />

                            <Spinner
                                android:id="@+id/spBurate2"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                android:layout_weight="1"
                                android:entries="@array/burate"
                                android:textSize="18dp" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnInit2"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="@string/serialport_open"
                            android:textSize="18dp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etCommand2"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:background="@drawable/button_style_stroke2"
                            android:hint="@string/serialport_input_cmd"
                            android:paddingLeft="10dp"
                            android:text="AA550200511D"
                            android:textSize="18dp" />

                        <EditText
                            android:id="@+id/etAuto2"
                            android:layout_width="60dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:hint="@string/auto_send_cmd_millisecond"
                            android:inputType="number"
                            android:paddingLeft="10dp"
                            android:text="500"
                            android:textSize="18dp" />

                        <CheckBox
                            android:id="@+id/cbMs2"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:layout_marginLeft="10dp"
                            android:layout_marginRight="10dp"
                            android:gravity="center"
                            android:text="@string/serialport_auto" />

                        <Button
                            android:id="@+id/btnTestSend2"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:text="@string/serialport_write_data"
                            android:textSize="18dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_alignParentLeft="true"
                            android:layout_centerInParent="true"
                            android:layout_weight="1"
                            android:gravity="left|center"
                            android:text="@string/serialport_input_cmd"
                            android:textSize="18dp" />

                        <Button
                            android:id="@+id/btnClear2"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_alignParentRight="true"
                            android:text="@string/serialport_clear"
                            android:textSize="18dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvResult2"
                        android:layout_width="match_parent"
                        android:layout_height="300dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_style_stroke2"
                        android:gravity="left|top"
                        android:scrollbars="vertical"
                        android:text="" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>