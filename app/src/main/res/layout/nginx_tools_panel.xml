<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp"
    android:orientation="vertical" android:background="@drawable/nginx_panel">
    <TextView android:layout_width="match_parent" android:layout_height="32dp"
        android:layout_marginLeft="10dp" android:text="@string/nginx_actions" android:textStyle="bold"
        android:textSize="16sp" android:textColor="@color/nginx_ink" />
    <androidx.appcompat.widget.AppCompatTextView android:id="@+id/nginxCheck" style="@style/NginxUtility"
        android:text="@string/nginx_check" android:enabled="false" android:drawableStart="@drawable/nginx_ic_check" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/nginx_background" />
    <androidx.appcompat.widget.AppCompatTextView android:id="@+id/btnVersion" style="@style/NginxUtility"
        android:text="@string/nginx_version" android:enabled="false" android:drawableStart="@drawable/nginx_ic_info" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/nginx_background" />
    <androidx.appcompat.widget.AppCompatTextView android:id="@+id/nginxPreview" style="@style/NginxUtility"
        android:text="@string/nginx_preview" android:enabled="false" android:drawableStart="@drawable/nginx_ic_page" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/nginx_background" />
    <androidx.appcompat.widget.AppCompatTextView android:id="@+id/nginxLogs" style="@style/NginxUtility"
        android:text="@string/nginx_logs" android:enabled="false" android:drawableStart="@drawable/nginx_ic_log" />
</LinearLayout>
