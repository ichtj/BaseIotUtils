<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rebootOverlayRoot"
    android:layout_width="wrap_content"
    android:layout_height="44dp"
    android:background="@drawable/reboot_overlay_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">

    <View
        android:id="@+id/rebootOverlayStatusDot"
        android:layout_width="10dp"
        android:layout_height="10dp" />

    <TextView
        android:id="@+id/rebootOverlayStatusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/reboot_overlay_text"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
