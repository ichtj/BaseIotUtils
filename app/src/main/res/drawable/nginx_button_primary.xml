<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false"><shape><solid android:color="@color/nginx_disabled"/><corners android:radius="9dp"/></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="@color/nginx_primary_pressed"/><corners android:radius="9dp"/></shape></item>
    <item android:state_focused="true"><shape><solid android:color="@color/nginx_primary_pressed"/><stroke android:width="2dp" android:color="@color/nginx_ink"/><corners android:radius="9dp"/></shape></item>
    <item><shape><solid android:color="@color/nginx_primary"/><corners android:radius="9dp"/></shape></item>
</selector>
