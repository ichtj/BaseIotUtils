<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="NginxAction" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:textColor">@color/nginx_action_text</item>
        <item name="android:background">@drawable/nginx_button_secondary</item>
        <item name="backgroundTint">@null</item>
    </style>
    <style name="NginxUtility">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/nginx_action_text</item>
        <item name="android:background">@drawable/nginx_utility_background</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:drawablePadding">12dp</item>
    </style>
</resources>
